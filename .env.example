# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me

# Dùng khi chạy backend ngoài Docker (đổi mật khẩu cho khớp POSTGRES_PASSWORD)
DATABASE_URL=postgresql+psycopg://clinic:change-me@localhost:5432/clinic

# CHỈ DEV, để review màn hình Tiếp đón khi chưa có đăng nhập thật (FR-TK-04). Đặt một chuỗi ngẫu nhiên
# dài; để trống ở mọi môi trường khác. Backend coi token này là Lễ tân; frontend tự gửi kèm token này.
DEV_STAFF_TOKEN=

# CHỈ DEV: origin được phép gọi API từ trình duyệt, phân tách bằng dấu phẩy. Để trống = tắt CORS.
# Khung xem trước dạng iframe sandbox có origin "null" nên cần "*" (backend không dùng cookie,
# chỉ nhận token qua header Authorization). KHÔNG đặt "*" ở môi trường thật.
CORS_ALLOW_ORIGINS=
